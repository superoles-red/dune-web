# build and local-only inputs (never commit game data)
.local/
node_modules/
__pycache__/
*.pyc
.DS_Store

# generated web bundle (built from MIT sources by tools/bundle_web.py)
web/vendor/
web/py-package.zip
web/reference.json

# test artifacts
test-results/
*.log

# generated python bundle (assembled by tools/bundle_web.py from committed sources)
web/py-src/genesis_recompiler/
web/py-src/dune-runtime.c
web/py-src/profile.json
web/py-src/reference.json
runtime/reference.json

# wasm prototype build products
prototype/wasm/build/
prototype/wasm/__pycache__/

# generated runtime wasm served to the browser
web/runtime/

# generated copies of the emitter and ABI for the browser bundle
web/py-src/wasm_emitter/
web/py-src/abi.json
web/py-src/game-reference.json
